# Demo is local-only, populated with fictional people. Real mode fails closed.
APP_MODE=demo
PORT=3000
# Real mode: APP_MODE=live. Set all values below before using real personal data.
DATABASE_URL=postgresql://friendcircle:friendcircle@localhost:5432/friendcircle
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use a production-grade MapLibre style provider in live deployments.
NEXT_PUBLIC_MAP_STYLE_URL=
# Comma-separated Supabase user UUIDs authorized to review reports and photos.
ADMIN_USER_IDS=
# Private face-detection service. Must return {faceCount:number, confidence:number}.
FACE_VERIFIER_URL=http://127.0.0.1:8001/verify
FACE_VERIFIER_TOKEN=
# Store photos outside the public directory, on an encrypted volume in production.
PHOTO_DIR=.data/photos
AVATAR_DIR=.data/avatars
# Meeting rewards: both accepted friends must share fresh GPS within 50 m.
REWARD_MINUTES=10
REWARD_CHARACTERS=100
REWARD_SOCIAL_CREDITS=5
# Legacy subscriptions can still open their billing portal. New map-range checkout is retired.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# Required for live HTTPS behind a reverse proxy.
PUBLIC_ORIGIN=
POSTGRES_PASSWORD=
